# =============================================================================
# ClientSync — environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in the values.
#   cp .env.example .env.local     # macOS / Linux
#   copy .env.example .env.local   # Windows PowerShell
#
# `.env.local` must NEVER be committed. Only `.env.example` is tracked.
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
#   Project URL      -> https://<your-project-ref>.supabase.co
#   anon / public    -> Project Settings -> API Keys -> anon public
#   service_role     -> Project Settings -> API Keys -> service_role  (SERVER ONLY)
#
# The service-role key BYPASSES Row Level Security. If it is ever exposed in a
# NEXT_PUBLIC_ variable it is a full database takeover. Never prefix it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend -----------------------------------------------------------------
# https://resend.com/api-keys
# Free tier: 3,000 emails/month, 100/day, 1 verified domain.
# Without this key the app still works — emails are skipped and logged.
RESEND_API_KEY=

# Verified sender. Either a domain you verified in Resend:
#   RESEND_FROM_EMAIL="ClientSync <notifications@yourdomain.com>"
# or, to try it with zero setup, the sandbox default:
#   RESEND_FROM_EMAIL="ClientSync <onboarding@resend.dev>"
RESEND_FROM_EMAIL=ClientSync <onboarding@resend.dev>

# --- App --------------------------------------------------------------------
# Public origin used to build magic links and email links.
# Local:  http://localhost:3000
# Vercel: auto-detected from VERCEL_PROJECT_PRODUCTION_URL — set explicitly
#         if you use a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_APP_NAME=ClientSync

# --- Optional ---------------------------------------------------------------
# Shared secret for POST /api/notify when called by a cron or external webhook.
# Generate: openssl rand -hex 32
# CRON_SECRET=
